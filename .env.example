# Copy to .env (gitignored) or export in your shell. Never commit real keys.
FANTASYPROS_API_KEY=your_api_key_here

# FantasyPros Public API tier is ~100 HTTP calls per day per key (429 when exceeded).
# Ingest defaults to position=ALL (one call per draft or per week). Cache under
# data/cache/fantasypros/ avoids repeat calls. Split --weeks across days if needed.
# FANTASYPROS_MIN_INTERVAL_SEC=8
# FANTASYPROS_429_BASE_WAIT_SEC=90
